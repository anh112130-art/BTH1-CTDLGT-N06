#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char hoten[30];
    int masv;
    float d1, d2, d3;
} Data;

typedef struct tagNode {
    Data infor;
    struct tagNode *next, *prev;
} Node;

typedef struct {
    Node *pHead;
    Node *pTail;
    int spt;
} DList;

/////////////////////////////////////
void initList(DList *L) {
    L->pHead = NULL;
    L->pTail = NULL;
    L->spt = 0;
}

int emptyList(DList L) {
    return (L.spt == 0);
}

/////////////////////////////////////
void insert_Head(DList *L, Data x) {
    Node *pp = (Node*) malloc(sizeof(Node));
    pp->infor = x;
    pp->next = NULL;
    pp->prev = NULL;

    if (emptyList(*L)) {
        L->pHead = pp;
        L->pTail = pp;
    } else {
        L->pHead->prev = pp;
        pp->next = L->pHead;
        L->pHead = pp;
    }
    L->spt++;
}

void insert_Tail(DList *L, Data x) {
    Node *pp = (Node*) malloc(sizeof(Node));
    pp->infor = x;
    pp->next = NULL;
    pp->prev = NULL;

    if (emptyList(*L)) {
        L->pHead = pp;
        L->pTail = pp;
    } else {
        L->pTail->next = pp;
        pp->prev = L->pTail;
        L->pTail = pp;
    }
    L->spt++;
}

void insert_After(DList *L, Node *q, Data x) {
    if (q == NULL) return;

    Node *pp = (Node*) malloc(sizeof(Node));
    pp->infor = x;
    pp->next = q->next;
    pp->prev = q;

    if (q->next != NULL) {
        q->next->prev = pp;
    }
    q->next = pp;

    if (q == L->pTail) {
        L->pTail = pp;
    }
    L->spt++;
}

/////////////////////////////////////
void del_Head(DList *L) {
    if (emptyList(*L)) return;

    Node *pp = L->pHead;
    L->pHead = pp->next;
    if (L->pHead != NULL) {
        L->pHead->prev = NULL;
    }
    free(pp);
    L->spt--;

    if (L->pHead == NULL) {
        L->pTail = NULL;
    }
}

void del_After(DList *L, Node *q) {
    if (q == NULL || q->next == NULL) return;

    Node *pp = q->next;
    q->next = pp->next;
    if (pp->next != NULL) {
        pp->next->prev = q;
    }

    if (pp == L->pTail) {
        L->pTail = q;
    }

    free(pp);
    L->spt--;
}

void del_ByName(DList *L, char K[30]) {
    Node *pp = L->pHead, *q = NULL;
    while (pp != NULL && strstr(pp->infor.hoten, K) == NULL) {
        q = pp;
        pp = pp->next;
    }

    if (pp == NULL) {
        printf("Khong tim thay sinh vien co ten chua \"%s\"!\n", K);
        return;
    }

    if (pp == L->pHead) {
        del_Head(L);
    } else {
        del_After(L, q);
    }
    printf("Da xoa sinh vien thanh cong!\n");
}

void del_ByID(DList *L, int masv) {
    Node *pp = L->pHead, *q = NULL;
    while (pp != NULL && pp->infor.masv != masv) {
        q = pp;
        pp = pp->next;
    }

    if (pp == NULL) {
        printf("Khong tim thay sinh vien co ma %d!\n", masv);
        return;
    }

    if (pp == L->pHead) {
        del_Head(L);
    } else {
        del_After(L, q);
    }
    printf("Da xoa sinh vien co ma %d thanh cong!\n", masv);
}

/////////////////////////////////////
Node* search_ByID(DList L, int masv) {
    Node *pp = L.pHead;
    while (pp != NULL && pp->infor.masv != masv) {
        pp = pp->next;
    }
    return pp;
}

void nhap(Data *x) {
    printf("Nhap ma sv (nhap <= 0 de huy): ");
    scanf("%d", &(x->masv));
    if (x->masv > 0) {
        printf("Nhap ho ten: ");
        getchar();
        fgets(x->hoten, sizeof(x->hoten), stdin);
        x->hoten[strcspn(x->hoten, "\n")] = '\0';

        printf("Nhap diem mon 1: ");
        scanf("%f", &(x->d1));
        printf("Nhap diem mon 2: ");
        scanf("%f", &(x->d2));
        printf("Nhap diem mon 3: ");
        scanf("%f", &(x->d3));
    }
}

float dtb(Data x) {
    return (x.d1 + x.d2 + x.d3) / 3.0f;
}

void in(Data x) {
    printf("Ten: %s, Ma: %d, D1: %.2f, D2: %.2f, D3: %.2f, DTB: %.2f\n",
           x.hoten, x.masv, x.d1, x.d2, x.d3, dtb(x));
}

void LIFO(DList *L) {
    Data x;
    initList(L);
    printf("--- Tao danh sach kieu LIFO (nhap masv <= 0 de dung) ---\n");
    do {
        nhap(&x);
        if (x.masv > 0) {
            insert_Head(L, x);
        }
    } while (x.masv > 0);
}

void FIFO(DList *L) {
    Data x;
    initList(L);
    printf("--- Tao danh sach kieu FIFO (nhap masv <= 0 de dung) ---\n");
    do {
        nhap(&x);
        if (x.masv > 0) {
            insert_Tail(L, x);
        }
    } while (x.masv > 0);
}

// Duyet xuoi tu pHead -> pTail
void processList(DList L) {
    if (emptyList(L)) {
        printf("Danh sach rong!\n");
        return;
    }
    Node *pp = L.pHead;
    while (pp != NULL) {
        in(pp->infor);
        pp = pp->next;
    }
}

// Duyet nguoc tu pTail -> pHead
void processList_Reverse(DList L) {
    if (emptyList(L)) {
        printf("Danh sach rong!\n");
        return;
    }
    Node *pp = L.pTail;
    while (pp != NULL) {
        in(pp->infor);
        pp = pp->prev;
    }
}

void clearList(DList *L) {
    while (!emptyList(*L)) {
        del_Head(L);
    }
}

/////////////////////////////////////
int main() {
    DList L;
    int kt = 0;
    Data x;
    initList(&L);

    do {
        printf("\n=== CHUONG TRINH LAM VIEC VOI DSLK KEP SV ===\n");
        printf("1: Them nut vao dau danh sach\n");
        printf("2: Them nut vao cuoi danh sach\n");
        printf("3: Them nut vao sau mot nut co ma SV\n");
        printf("4: Tao danh sach kieu LIFO (chen dau)\n");
        printf("5: Tao danh sach kieu FIFO (chen cuoi)\n");
        printf("6: Xoa nut dau danh sach\n");
        printf("7: Xoa sinh vien theo ten\n");
        printf("8: Xoa sinh vien theo ma SV\n");
        printf("9: Duyet ds (tu dau den cuoi)\n");
        printf("10: Duyet ds nguoc (tu cuoi ve dau)\n");
        printf("0: Thoat\n");
        printf("Moi ban chon: ");

        int chon;
        scanf("%d", &chon);

        switch (chon) {
            case 1:
                printf("Nhap thong tin sv can them vao dau:\n");
                nhap(&x);
                if (x.masv > 0) insert_Head(&L, x);
                break;

            case 2:
                printf("Nhap thong tin sv can them vao cuoi:\n");
                nhap(&x);
                if (x.masv > 0) insert_Tail(&L, x);
                break;

            case 3: {
                int maTim;
                printf("Nhap ma SV cua nut dung truoc: ");
                scanf("%d", &maTim);
                Node *q = search_ByID(L, maTim);
                if (q == NULL) {
                    printf("Khong tim thay SV co ma %d!\n", maTim);
                } else {
                    printf("Nhap thong tin sv can them vao sau:\n");
                    nhap(&x);
                    if (x.masv > 0) insert_After(&L, q, x);
                }
                break;
            }

            case 4:
                LIFO(&L);
                break;

            case 5:
                FIFO(&L);
                break;

            case 6:
                if (emptyList(L)) {
                    printf("Danh sach rong!\n");
                } else {
                    del_Head(&L);
                    printf("Da xoa nut dau danh sach!\n");
                }
                break;

            case 7: {
                char name[30];
                printf("Ban muon xoa sv co ten ? ");
                getchar();
                fgets(name, sizeof(name), stdin);
                name[strcspn(name, "\n")] = '\0';
                del_ByName(&L, name);
                break;
            }

            case 8: {
                int maXoa;
                printf("Ban muon xoa sv co ma ? ");
                scanf("%d", &maXoa);
                del_ByID(&L, maXoa);
                break;
            }

            case 9:
                printf("\n--- Danh sach sinh vien ---\n");
                processList(L);
                break;

            case 10:
                printf("\n--- Danh sach sinh vien (nguoc) ---\n");
                processList_Reverse(L);
                break;

            case 0:
                clearList(&L);
                printf("Bye bye\n");
                kt = 1;
                break;

            default:
                printf("Lua chon khong hop le!\n");
                break;
        }
    } while (kt == 0);

    return 0;
}
