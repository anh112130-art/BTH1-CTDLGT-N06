
#include <iostream>
#include <math.h>
using namespace std;

int main() {
    int n, i;
    int kt = 1;

    cout << "Nhap n: ";
    cin >> n;

    if (n < 2) {
        kt = 0;
    }
    else {
        for (i = 2; i <= sqrt(n); i++) {
            if (n % i == 0) {
                kt = 0;
                break;
            }
        }
    }

    if (kt == 1)
        cout << n << " la so nguyen to";
    else
        cout << n << " khong la so nguyen to";

    return 0;
}
