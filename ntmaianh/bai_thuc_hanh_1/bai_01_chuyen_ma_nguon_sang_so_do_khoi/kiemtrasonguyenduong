#include<iostream>
#include<math.h>
using namespace std;
int main() {
	int n;
	int count = 0;
	printf("Nhap so nguyen to: ");
	scanf("%d", &n);
	if(n < 2){
	    count = 1; 
	}else{
		for(i=2; i<= sqrt(n); i++)
		if(n % i == 0){
			count = 1;
			break;
		}
	}
	if (count == 0){
		printf("%d la so nguyen to", n);
	}
	else {
		printf("%d khong la so nguyen to", n);
	}
return 0;
}
