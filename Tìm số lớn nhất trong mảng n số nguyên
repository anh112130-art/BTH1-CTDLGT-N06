
#include <iostream>
using namespace std;

int main() {
    int a[100];
    int n, i, max;

    cout << "Nhap so phan tu n: ";
    cin >> n;

    for (i = 0; i < n; i++) {
        cout << "a[" << i << "] = ";
        cin >> a[i];
    }

    max = a[0];

    for (i = 1; i < n; i++) {
        if (a[i] > max) {
            max = a[i];
        }
    }

    cout << "So lon nhat trong mang la: " << max;

    return 0;
}
